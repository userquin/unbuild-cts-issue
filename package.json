{
  "name": "unbuild-cts-issue",
  "type": "module",
  "version": "1.0.0",
  "description": "unbuild node10 and node16 dts issue",
  "scripts": {
    "prepack": "tsup",
    "test:attw": "attw --pack"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./esmonly": "./dist/esmonly.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "esmonly": [
        "dist/esmonly.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/node": "^22.13.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "unbuild": "file:unbuild-3.3.1.tgz"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.4.1"
}
